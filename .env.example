# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and anon (public) key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the site, used in email links and calendar files.
# On Vercel this falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Email (Phase C). Server-only: never prefix these with NEXT_PUBLIC_. ---
# Brevo API key (Brevo → SMTP & API → API Keys). Without it, emails are skipped and logged.
BREVO_API_KEY=
# Brevo contact list ID for the member newsletter list (Brevo → Contacts → Lists).
BREVO_LIST_ID=
# Optional: override the Brevo API base URL (the local test stack uses a mock).
# BREVO_API_URL=https://api.brevo.com/v3
# Protects the daily email job (/api/cron/daily). Vercel Cron sends it automatically.
CRON_SECRET=
# Supabase service_role key, used only by the daily email job and to look up recipients. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Zoom attendance (Phase D). Server-only. From the group's Zoom Server-to-Server OAuth app
# (marketplace.zoom.us → Develop → your app → App credentials). Without them, Zoom import is off.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Optional overrides (the local test stack uses a mock).
# ZOOM_API_URL=https://api.zoom.us/v2
# ZOOM_OAUTH_URL=https://zoom.us/oauth/token

# --- Live chat (Tidio). Public key from Tidio → Settings → Installation
# (embed code //code.tidio.co/PUBLIC_KEY.js). Leave empty to keep live chat off.
NEXT_PUBLIC_TIDIO_PUBLIC_KEY=
