# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and anon (public) key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the site, used in email links and calendar files.
# On Vercel this falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

