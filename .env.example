# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and anon (public) key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the site, used in email links and calendar files.
# On Vercel this falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Email (Phase C). Server-only: never prefix these with NEXT_PUBLIC_. ---
# Brevo API key (Brevo → SMTP & API → API Keys). Without it, emails are skipped and logged.
BREVO_API_KEY=
# Brevo contact list ID for the member newsletter list (Brevo → Contacts → Lists).
BREVO_LIST_ID=
# Optional: override the Brevo API base URL (the local test stack uses a mock).
# BREVO_API_URL=https://api.brevo.com/v3
# Protects the daily email job (/api/cron/daily). Vercel Cron sends it automatically.
CRON_SECRET=
# Supabase service_role key, used only by the daily email job and to look up recipients. Server-only.
SUPABASE_SERVICE_ROLE_KEY=
